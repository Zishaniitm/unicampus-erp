{
  "name": "unicampus-erp-backend",
  "version": "1.0.0",
  "description": "UniCampus ERP Backend API — United Institute of Management (FUGS)",
  "main": "dist/app.js",
  "scripts": {
    "dev":           "npx ts-node-dev --respawn --transpile-only --project tsconfig.json src/app.ts",
    "build":         "npx tsc",
    "start":         "node dist/app.js",
    "test":          "npx jest",
    "test:watch":    "npx jest --watch",
    "test:coverage": "npx jest --coverage",
    "test:unit":     "npx jest tests/unit/",
    "db:migrate":    "npx ts-node --project tsconfig.json --transpile-only src/db/migrate.ts",
    "lint":          "npx tsc --noEmit"
  },
  "keywords": ["erp", "college", "management"],
  "author": "Zishan Ahmad",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.7.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "minio": "^7.1.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "pg": "^8.11.5",
    "razorpay": "^2.9.2",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "drizzle-kit": "^0.21.4",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
